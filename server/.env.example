# Server configuration. Copy to .env and adjust.
PORT=4000
HOST=0.0.0.0

# REQUIRED in production: a long random string used to sign JWTs.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Data layer. "sqlite" (default) uses DB_FILE below; "postgres" uses
# SUPABASE_DB_URL. See ../supabase/README.md for setup + the schema migration.
DB_DRIVER=sqlite

# SQLite database file location (used when DB_DRIVER=sqlite).
DB_FILE=./data/connecta.sqlite

# Postgres/Supabase connection string (used when DB_DRIVER=postgres).
# From Supabase: Project Settings -> Database -> Connection string (URI).
SUPABASE_DB_URL=

# WebRTC ICE servers. Public STUN is included by default.
# For calls that must work across strict NAT/firewalls (i.e. production),
# configure a TURN relay. Two options:
#
# (A) RECOMMENDED — coturn shared-secret. Set TURN_HOST + TURN_SECRET (the same
#     secret coturn runs with). The server then mints short-lived HMAC
#     credentials per user automatically. See ../coturn/turnserver.conf.
TURN_HOST=
TURN_SECRET=
TURN_TTL=86400
#
# (B) Static ICE list (e.g. a managed TURN provider). Separate servers with "|".
# Example:
# ICE_SERVERS=turn:turn.example.com:3478?user=webrtc&pass=secret|turns:turn.example.com:5349?user=webrtc&pass=secret
ICE_SERVERS=

# Large group calls via a self-hosted LiveKit SFU (optional). When all three are
# set, group calls route media through the SFU instead of full-mesh WebRTC.
# See ../README.md "Large group calls — LiveKit SFU".
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

