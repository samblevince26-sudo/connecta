# Root environment for `docker compose` (see docker-compose.yml).
# For running the server bare-metal instead, use server/.env.example.

# Long random string signing the JWTs.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Publicly-reachable address of the coturn server (IP or hostname).
# This is what clients put in their ICE server list, so it must be reachable
# from the internet — NOT an internal docker name.
TURN_HOST=203.0.113.10

# Shared secret. MUST be identical here and in the Connecta server env; coturn
# validates the HMAC credentials the server mints against this same secret.
TURN_SECRET=replace-with-a-long-random-secret

# coturn realm (any domain-like string).
TURN_REALM=connecta.example.com

# The server's public IP as seen from outside (for coturn --external-ip).
# On a 1:1 NAT box you can use "PUBLIC_IP/PRIVATE_IP".
TURN_EXTERNAL_IP=203.0.113.10

# Lifetime of minted TURN credentials, seconds.
TURN_TTL=86400
